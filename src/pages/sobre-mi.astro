---
import BaseLayout from "../layouts/BaseLayout.astro";
import LanguageSwitcher from "../components/LanguageSwitcher.astro";
import sergi from "../assets/sergi.jpg";

const lang = Astro.url.searchParams.get("lang") === "en" ? "en" : "es";
const en = lang === "en";
---

<BaseLayout
  lang={lang}
  title={en ? "Sergi Ortega, surf and sports photographer in Cádiz" : "Sergi Ortega, fotógrafo de surf y deporte en Cádiz"}
  description={en ? "Discover Sergi Ortega's surf and sports photography, visual storytelling and aquatic photography equipment in Cádiz." : "Conoce la fotografía deportiva y de surf de Sergi Ortega, su narrativa visual y su equipo de fotografía acuática en Cádiz."}
>
  <div class="page-gradient-shell">
    <h1 class="sr-only">{en ? "Sergi Ortega, surf and sports photographer in Cádiz" : "Sergi Ortega, fotógrafo de surf y deporte en Cádiz"}</h1>

    <section class="about">
      <div class="about__inner container">
        <div class="about__image-col reveal">
          <img
            src={sergi.src}
            alt={en ? "Portrait of Sergi Ortega" : "Retrato de Sergi Ortega"}
            width={sergi.width}
            height={sergi.height}
            class="about__portrait"
            loading="eager"
            decoding="async"
          />
          <span class="about__image-caption label"
            >Sergi Ortega — Est. Mediterranean Coast</span
          >
        </div>
        <div class="about__text-col">
          <LanguageSwitcher path="/sobre-mi" language={lang} />
          <span class="label reveal">THE CHURFER</span>
          <h2 class="about__heading reveal"><em>{en ? "Sports Photography & Visual Storytelling" : "Fotografía deportiva y narrativa visual"}</em></h2>
          <p class="about__bio reveal">
            {en ? "I’m a sports photographer specializing in surf photography, driven by adrenaline, speed and the pursuit of the decisive moment. From surfing to any other sport, I capture the intensity, emotion and details that tell the story behind every image." : "Soy fotógrafo deportivo especializado en surf, impulsado por la adrenalina, la velocidad y la búsqueda del instante decisivo. Del surf a cualquier otra disciplina deportiva, capturo la intensidad, la emoción y los detalles que cuentan la historia detrás de cada imagen."}
          </p>
          <p class="about__bio reveal">
            {en ? "My work goes beyond freezing the action. It’s about capturing moments that happen in a fraction of a second and turning them into powerful visual stories for brands, athletes and organizations." : "Mi trabajo va más allá de congelar la acción. Se trata de capturar momentos que suceden en una fracción de segundo y transformarlos en historias visuales impactantes para marcas, deportistas y organizaciones."}
          </p>
          <p class="about__bio about__closing reveal">{en ? "Every split second tells a story." : "Cada fracción de segundo cuenta una historia."}</p>
          <div class="about__equipment reveal">
            <h3 class="label">{en ? "EQUIPMENT" : "EQUIPO"}</h3>
            <div class="about__equipment-grid">
              <div>
                <h4>{en ? "Camera bodies" : "Cámaras"}</h4>
                <ul><li>Sony α1 II</li><li>Sony α7R III</li></ul>
              </div>
              <div>
                <h4>{en ? "Lenses" : "Objetivos"}</h4>
                <ul>
                  <li>Sony FE 200–600{en ? "mm" : " mm"} F5.6–6.3 G OSS</li>
                  <li>Sony FE 70–200{en ? "mm" : " mm"} F4 G OSS</li>
                  <li>Sony FE 85{en ? "mm" : " mm"} F1.8</li>
                  <li>Sony FE 35{en ? "mm" : " mm"} F1.8</li>
                </ul>
              </div>
              <div>
                <h4>{en ? "Aquatic photography" : "Fotografía acuática"}</h4>
                <ul><li>{en ? "AquaTech underwater housing system." : "Sistema de carcasa acuática AquaTech."}</li></ul>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="about-cta">
      <div class="about-cta__inner container reveal">
        <span class="label">{en ? "Shall we work together?" : "¿Trabajamos juntos?"}</span>
        <h2 class="about-cta__heading">{en ? "Let's talk about your" : "Hablemos de tu"} <em>{en ? "project" : "proyecto"}</em></h2>
        <p class="about-cta__text">
          {en ? "Photo sessions, commercial video, music videos or event coverage — get in touch." : "Sesiones de foto, vídeo comercial, videoclips o cobertura de eventos — escríbeme."}
        </p>
        <a href={en ? "/contacto?lang=en" : "/contacto"} class="cta-button">{en ? "Contact me" : "Contactar"}</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-gradient-shell {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    padding-top: calc(var(--header-height) + var(--space-xl));
    overflow: hidden;
  }

  .page-gradient-shell::before,
  .page-gradient-shell::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    pointer-events: none;
  }

  .page-gradient-shell::before {
    inset-block: 0;
    background: linear-gradient(
      var(--hero-gradient-angle),
      var(--color-hero-1) var(--hero-stop-1),
      var(--color-hero-2) var(--hero-stop-2),
      var(--color-hero-3) var(--hero-stop-3),
      var(--color-hero-4) var(--hero-stop-4)
    );
    animation: heroShift 20s ease-in-out infinite alternate;
    z-index: -2;
  }

  .page-gradient-shell::after {
    inset-block: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(10, 10, 10, 0.08) 0%,
        var(--color-bg) 92%
      ),
      linear-gradient(to right, rgba(10, 10, 10, 0.58) 0%, transparent 64%);
    z-index: -1;
  }

  /* ═══ ABOUT ═══ */
  .about {
    display: flex;
    align-items: center;
    min-height: calc(100vh - var(--header-height) - var(--space-xl));
    padding-block: var(--space-lg) var(--space-section);
  }

  .about__inner {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-xl);
    align-items: center;
    width: 100%;
  }

  .about__portrait {
    aspect-ratio: 3 / 4;
    border: 1px solid var(--color-border);
    width: 100%;
    object-fit: cover;
  }

  .about__image-caption {
    margin-top: var(--space-sm);
    display: block;
  }

  .about__heading {
    margin-top: var(--space-xs);
  }

  .about__bio {
    color: var(--color-text-muted);
    margin-top: var(--space-sm);
    line-height: 1.85;
  }

  .about__closing { color: var(--color-sunset); }

  .about__equipment {
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .about__equipment-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-md) var(--space-lg);
    margin-top: var(--space-sm);
  }

  .about__equipment h4 { font-size: var(--text-base); margin-bottom: 0.35em; }
  .about__equipment ul { list-style: none; padding: 0; margin: 0; color: var(--color-text-muted); line-height: 1.7; }

  @media (max-width: 480px) {
    .about__equipment-grid { grid-template-columns: 1fr; }
  }

  @media (max-width: 900px) {
    .page-gradient-shell {
      padding-top: calc(var(--header-height) + var(--space-xs));
    }

    .about {
      display: block;
      min-height: 0;
      padding-block: 0 var(--space-section);
    }

    .about__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .about__text-col {
      order: -1;
    }

    .about__image-col {
      order: 1;
      max-width: 400px;
    }
  }

  /* ═══ CTA ═══ */
  .about-cta {
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-border);
  }

  .about-cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .about-cta__heading {
    margin-top: var(--space-xs);
  }

  .about-cta__text {
    color: var(--color-text-muted);
    text-align: center;
    max-width: 50ch;
  }
</style>
