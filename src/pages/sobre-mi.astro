---
import BaseLayout from "../layouts/BaseLayout.astro";
import sergi from "../assets/sergi.jpg";
---

<BaseLayout
  title="Sergi Ortega, fotógrafo de surf y videógrafo en Cádiz"
  description="Conoce a Sergi Ortega, fotógrafo de surf, fotografía deportiva y videografía en El Palmar, Cádiz. Una trayectoria ligada al mar, la acción y la producción audiovisual para marcas y proyectos creativos."
>
  <div class="page-gradient-shell">
    <h1 class="sr-only">
      Sergi Ortega, fotógrafo de surf y videógrafo en Cádiz
    </h1>

    <!-- ═══ ABOUT ═══ -->
    <section class="about">
      <div class="about__inner container">
        <div class="about__image-col reveal">
          <img
            src={sergi.src}
            alt="Retrato de Sergi Ortega"
            width={sergi.width}
            height={sergi.height}
            class="about__portrait"
            loading="eager"
            decoding="async"
          />
          <span class="about__image-caption label"
            >Sergi Ortega — Est. Mediterranean Coast</span
          >
        </div>
        <div class="about__text-col">
          <span class="label reveal">Quién soy</span>
          <h2 class="about__heading reveal"><em>Sergi Ortega</em></h2>
          <p class="about__bio reveal">
            Cámara profesional especializado en fotografía deportiva y
            producción audiovisual. El surf y la foto marina son mi terreno
            natural, pero mi objetivo también apunta al jiu-jitsu, el skate y
            cualquier disciplina que transmita fuerza y movimiento. Grabo y
            edito vídeos comerciales para marcas y he trabajado en videoclips
            musicales.
          </p>
          <p class="about__bio reveal">
            De origen mediterráneo y afincado en El Palmar, donde además de la
            cámara gestiono <strong>Santa Killa</strong>, una tienda y marca de
            surf. Cada proyecto es único y mi objetivo es capturarlo con la
            intensidad que merece.
          </p>
          <div class="about__stats reveal">
            <div class="about__stat">
              <span class="about__stat-number">+500</span>
              <span class="about__stat-label label">Sesiones</span>
            </div>
            <div class="about__stat">
              <span class="about__stat-number">+30</span>
              <span class="about__stat-label label">Producciones</span>
            </div>
            <div class="about__stat">
              <span class="about__stat-number">+8</span>
              <span class="about__stat-label label">Años</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <section class="about-cta">
      <div class="about-cta__inner container reveal">
        <span class="label">¿Trabajamos juntos?</span>
        <h2 class="about-cta__heading">Hablemos de tu <em>proyecto</em></h2>
        <p class="about-cta__text">
          Sesiones de foto, vídeo comercial, videoclips o cobertura de eventos —
          escríbeme.
        </p>
        <a href="/contacto" class="cta-button">Contactar</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .page-gradient-shell {
    position: relative;
    isolation: isolate;
    min-height: 100vh;
    padding-top: calc(var(--header-height) + var(--space-xl));
    overflow: hidden;
  }

  .page-gradient-shell::before,
  .page-gradient-shell::after {
    content: "";
    position: absolute;
    inset-inline: 0;
    top: 0;
    pointer-events: none;
  }

  .page-gradient-shell::before {
    inset-block: 0;
    background: linear-gradient(
      var(--hero-gradient-angle),
      var(--color-hero-1) var(--hero-stop-1),
      var(--color-hero-2) var(--hero-stop-2),
      var(--color-hero-3) var(--hero-stop-3),
      var(--color-hero-4) var(--hero-stop-4)
    );
    animation: heroShift 20s ease-in-out infinite alternate;
    z-index: -2;
  }

  .page-gradient-shell::after {
    inset-block: 0;
    background:
      linear-gradient(
        to bottom,
        rgba(10, 10, 10, 0.08) 0%,
        var(--color-bg) 92%
      ),
      linear-gradient(to right, rgba(10, 10, 10, 0.58) 0%, transparent 64%);
    z-index: -1;
  }

  /* ═══ ABOUT ═══ */
  .about {
    display: flex;
    align-items: center;
    min-height: calc(100vh - var(--header-height) - var(--space-xl));
    padding-block: var(--space-lg) var(--space-section);
  }

  .about__inner {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: var(--space-xl);
    align-items: center;
    width: 100%;
  }

  .about__portrait {
    aspect-ratio: 3 / 4;
    border: 1px solid var(--color-border);
    width: 100%;
    object-fit: cover;
  }

  .about__image-caption {
    margin-top: var(--space-sm);
    display: block;
  }

  .about__heading {
    margin-top: var(--space-xs);
  }

  .about__bio {
    color: var(--color-text-muted);
    margin-top: var(--space-sm);
    line-height: 1.85;
  }

  .about__stats {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-lg);
    padding-top: var(--space-md);
    border-top: 1px solid var(--color-border);
  }

  .about__stat-number {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--color-sunset);
    display: block;
    line-height: 1;
  }

  .about__stat-label {
    margin-top: 0.3em;
    display: block;
  }

  @media (max-width: 900px) {
    .page-gradient-shell {
      padding-top: calc(var(--header-height) + var(--space-xs));
    }

    .about {
      display: block;
      min-height: 0;
      padding-block: 0 var(--space-section);
    }

    .about__inner {
      grid-template-columns: 1fr;
      gap: var(--space-lg);
    }

    .about__text-col {
      order: -1;
    }

    .about__image-col {
      order: 1;
      max-width: 400px;
    }
  }

  /* ═══ CTA ═══ */
  .about-cta {
    padding-block: var(--space-section);
    border-top: 1px solid var(--color-border);
  }

  .about-cta__inner {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }

  .about-cta__heading {
    margin-top: var(--space-xs);
  }

  .about-cta__text {
    color: var(--color-text-muted);
    text-align: center;
    max-width: 50ch;
  }
</style>
