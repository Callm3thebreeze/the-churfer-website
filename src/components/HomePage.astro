---
import { Image as AstroImage, getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import smallLogo from "../assets/small-logo.png";
import { getGalleryData } from "../lib/photo-gallery";
import {
  getTaxonomyGroupIds,
  PHOTO_FILTER_GROUPS,
  type PhotoFilterGroupDefinition,
} from "../lib/photo-taxonomy";

const { photos, filters } = await getGalleryData();
const availableFilterIds = new Set(filters.map(({ id }) => id));
const HOME_FILTER_GROUPS = PHOTO_FILTER_GROUPS;

type CategoryHighlight = (typeof photos)[number] & {
  categoryId: string;
  categoryLabel: string;
  href: string;
};

function matchesFilterIds(photo: (typeof photos)[number], filterIds: string[]) {
  return filterIds.some(
    (id) => photo.category === id || photo.tags.includes(id),
  );
}

function getPreferredFilterId(
  filter: Pick<PhotoFilterGroupDefinition, "id" | "aliases">,
) {
  if (availableFilterIds.has(filter.id)) {
    return filter.id;
  }

  return filter.aliases?.find((id) => availableFilterIds.has(id)) ?? filter.id;
}

function getGalleryHref(
  filter: Pick<PhotoFilterGroupDefinition, "id" | "aliases">,
) {
  return `/fotografia?categoria=${encodeURIComponent(getPreferredFilterId(filter))}`;
}

function buildHighlight(
  photo: (typeof photos)[number],
  filter: Pick<PhotoFilterGroupDefinition, "id" | "label" | "aliases">,
): CategoryHighlight {
  return {
    ...photo,
    categoryId: filter.id,
    categoryLabel: filter.label,
    href: getGalleryHref(filter),
  };
}

const fallbackPhoto = photos[0];
const categoryPhotos: CategoryHighlight[] = [];

for (const group of HOME_FILTER_GROUPS) {
  const groupPhoto =
    photos.find((photo) =>
      matchesFilterIds(photo, getTaxonomyGroupIds(group)),
    ) ?? fallbackPhoto;

  if (!groupPhoto) {
    continue;
  }

  categoryPhotos.push({
    ...buildHighlight(groupPhoto, group),
  });
}

async function withLightboxSrc(photo: CategoryHighlight) {
  if (!photo.image) {
    return {
      ...photo,
      lightboxSrc: photo.src,
    };
  }

  const lightboxImage = await getImage({
    src: photo.image,
    width: 2200,
    format: "webp",
    quality: 74,
  });

  return {
    ...photo,
    lightboxSrc: lightboxImage.src,
  };
}

const featuredPhotos = await Promise.all(
  categoryPhotos.map((photo) => withLightboxSrc(photo)),
);
---

<BaseLayout
  title="Fotógrafo de Surf en Cádiz con mirada acuática"
  description="Fotografía de surf, mar y deporte desde El Palmar, Cádiz. The Churfer une mirada documental, energía visual y sensibilidad cinematográfica para marcas, atletas y proyectos editoriales."
  hideFooter={true}
  hideHeaderLogo={true}
>
  <section class="home-section home-section--photos">
    <div class="home-section__inner container">
      <h1 class="sr-only">
        Fotógrafo de surf, fotografía acuática y deportes de acción en Cádiz
      </h1>

      <a class="home-brand-logo" href="/" aria-label="The Churfer">
        <img
          src={smallLogo.src}
          alt="The Churfer"
          width={smallLogo.width}
          height={smallLogo.height}
          loading="eager"
          decoding="async"
        />
      </a>

      <div
        class="home-photo-carousel reveal is-visible"
        data-photo-carousel
        role="region"
        aria-label={`Parrilla con ${featuredPhotos.length} filtros principales`}
      >
        <div class="home-photo-carousel__viewport" data-photo-carousel-viewport>
          <div class="home-photo-carousel__track" data-photo-carousel-track>
            {
              featuredPhotos.map((photo, index) => (
                <a
                  href={photo.href}
                  class={`home-photo-carousel__slide home-photo-carousel__slide--primary reveal-delay-${(index % 4) + 1}`}
                  aria-label={`Ver galería de ${photo.categoryLabel}`}
                >
                  <div class="home-photo-carousel__media">
                    {photo.image ? (
                      <AstroImage
                        src={photo.image}
                        alt={photo.alt}
                        class="home-photo-carousel__image"
                        loading="lazy"
                        format="webp"
                        quality={72}
                        sizes="(max-width: 768px) 88vw, (max-width: 1100px) 44vw, 34vw"
                        widths={[720, 1120, 1600]}
                      />
                    ) : (
                      <img
                        src={photo.src}
                        alt={photo.alt}
                        class="home-photo-carousel__image"
                        loading="lazy"
                        decoding="async"
                        width={photo.width}
                        height={photo.height}
                      />
                    )}

                    <span class="home-photo-carousel__category-label">
                      {photo.categoryLabel}
                    </span>
                  </div>
                </a>
              ))
            }
          </div>
        </div>

        <div
          class="home-photo-carousel__status sr-only"
          aria-live="polite"
          data-carousel-status
        >
          Filtro 1 de {featuredPhotos.length}
        </div>
      </div>
    </div>
  </section>

  <div
    class="lightbox"
    id="home-lightbox"
    aria-hidden="true"
    role="dialog"
    aria-label="Galería ampliada"
  >
    <button class="lightbox__close" type="button" aria-label="Cerrar galería">
      <svg
        width="28"
        height="28"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>
    <button
      class="lightbox__arrow lightbox__arrow--prev"
      type="button"
      aria-label="Imagen anterior"
    >
      <svg
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="M15 18l-6-6 6-6"></path>
      </svg>
    </button>
    <button
      class="lightbox__arrow lightbox__arrow--next"
      type="button"
      aria-label="Imagen siguiente"
    >
      <svg
        width="32"
        height="32"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
      >
        <path d="M9 18l6-6-6-6"></path>
      </svg>
    </button>
    <div class="lightbox__content">
      <img
        class="lightbox__placeholder is-ready"
        id="home-lightbox-image"
        src={featuredPhotos[0]?.lightboxSrc ?? ""}
        alt="Imagen ampliada"
        loading="eager"
        decoding="async"
      />
      <div class="lightbox__info">
        <h3 class="lightbox__title" id="home-lightbox-title"></h3>
        <span class="lightbox__cat label" id="home-lightbox-cat"></span>
        <span class="lightbox__counter" id="home-lightbox-counter"></span>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  const photoCarousel = document.querySelector("[data-photo-carousel]");
  const photoCarouselSection = document.querySelector(".home-section--photos");
  const homeLightbox = document.getElementById("home-lightbox");
  const homeLightboxItems = Array.from(
    document.querySelectorAll("[data-home-lightbox-item]"),
  );

  if (photoCarousel instanceof HTMLElement) {
    const viewport = photoCarousel.querySelector(
      "[data-photo-carousel-viewport]",
    );
    const track = photoCarousel.querySelector("[data-photo-carousel-track]");
    const prevButton = photoCarouselSection?.querySelector(
      "[data-carousel-prev]",
    );
    const nextButton = photoCarouselSection?.querySelector(
      "[data-carousel-next]",
    );
    const status = photoCarousel.querySelector("[data-carousel-status]");
    const dots = Array.from(
      photoCarousel.querySelectorAll("[data-carousel-dot]"),
    );

    if (
      viewport instanceof HTMLElement &&
      track instanceof HTMLElement &&
      prevButton instanceof HTMLButtonElement &&
      nextButton instanceof HTMLButtonElement &&
      status instanceof HTMLElement
    ) {
      let activeIndex = 0;

      const getStep = () => {
        const firstSlide = track.querySelector(".home-photo-carousel__slide");

        if (!(firstSlide instanceof HTMLElement)) {
          return viewport.clientWidth * 0.8;
        }

        const trackStyles = getComputedStyle(track);
        const gap = Number.parseFloat(
          trackStyles.columnGap || trackStyles.gap || "0",
        );
        return firstSlide.getBoundingClientRect().width + gap;
      };

      const getActiveIndex = () => {
        const step = getStep();

        if (!Number.isFinite(step) || step <= 0) {
          return 0;
        }

        return Math.max(
          0,
          Math.min(dots.length - 1, Math.round(viewport.scrollLeft / step)),
        );
      };

      const updateDots = () => {
        activeIndex = getActiveIndex();

        dots.forEach((dot, index) => {
          if (!(dot instanceof HTMLButtonElement)) {
            return;
          }

          const isActive = index === activeIndex;
          dot.dataset.active = isActive ? "true" : "false";
          dot.setAttribute("aria-selected", isActive ? "true" : "false");
          dot.setAttribute("aria-current", isActive ? "true" : "false");
        });

        status.textContent = `Filtro ${activeIndex + 1} de ${dots.length}`;
      };

      const updateButtons = () => {
        const maxScrollLeft = viewport.scrollWidth - viewport.clientWidth - 2;
        const hasOverflow = viewport.scrollWidth > viewport.clientWidth + 2;

        prevButton.disabled = !hasOverflow || viewport.scrollLeft <= 2;
        nextButton.disabled =
          !hasOverflow || viewport.scrollLeft >= maxScrollLeft;
      };

      prevButton.addEventListener("click", () => {
        viewport.scrollTo({
          left: getStep() * Math.max(0, activeIndex - 1),
          behavior: "smooth",
        });
      });

      nextButton.addEventListener("click", () => {
        viewport.scrollTo({
          left: getStep() * Math.min(dots.length - 1, activeIndex + 1),
          behavior: "smooth",
        });
      });

      dots.forEach((dot, index) => {
        if (!(dot instanceof HTMLButtonElement)) {
          return;
        }

        dot.addEventListener("click", () => {
          viewport.scrollTo({
            left: getStep() * index,
            behavior: "smooth",
          });
          dot.focus({ preventScroll: true });
        });
      });

      viewport.addEventListener(
        "scroll",
        () => {
          updateButtons();
          updateDots();
        },
        { passive: true },
      );
      window.addEventListener("resize", () => {
        updateButtons();
        updateDots();
      });
      updateButtons();
      updateDots();
    }
  }

  if (homeLightbox instanceof HTMLElement && homeLightboxItems.length > 0) {
    const lightboxImage = document.getElementById("home-lightbox-image");
    const lightboxTitle = document.getElementById("home-lightbox-title");
    const lightboxCat = document.getElementById("home-lightbox-cat");
    const lightboxCounter = document.getElementById("home-lightbox-counter");
    const closeButton = homeLightbox.querySelector(".lightbox__close");
    const prevArrow = homeLightbox.querySelector(".lightbox__arrow--prev");
    const nextArrow = homeLightbox.querySelector(".lightbox__arrow--next");

    if (
      lightboxImage instanceof HTMLImageElement &&
      lightboxTitle instanceof HTMLElement &&
      lightboxCat instanceof HTMLElement &&
      lightboxCounter instanceof HTMLElement &&
      closeButton instanceof HTMLButtonElement &&
      prevArrow instanceof HTMLButtonElement &&
      nextArrow instanceof HTMLButtonElement
    ) {
      let currentLightboxIndex = 0;
      let lightboxImageToken = 0;

      const syncScrollLock = () => {
        document.body.style.overflow =
          homeLightbox.getAttribute("aria-hidden") !== "true" ? "hidden" : "";
      };

      const swapLightboxImage = (
        src = "",
        alt = "Imagen ampliada",
        aspect = "",
      ) =>
        new Promise((resolve) => {
          const currentSrc = lightboxImage.getAttribute("src") ?? "";

          if (currentSrc === src) {
            lightboxImage.alt = alt;
            if (aspect) {
              lightboxImage.style.aspectRatio = aspect;
            }
            lightboxImage.classList.add("is-ready");
            resolve(undefined);
            return;
          }

          const token = ++lightboxImageToken;
          lightboxImage.classList.remove("is-ready");
          if (aspect) {
            lightboxImage.style.aspectRatio = aspect;
          }

          const preloaded = new window.Image();
          preloaded.decoding = "async";
          preloaded.src = src;

          const applyImage = () => {
            if (token !== lightboxImageToken) {
              resolve(undefined);
              return;
            }

            lightboxImage.src = src;
            lightboxImage.alt = alt;
            requestAnimationFrame(() => {
              lightboxImage.classList.add("is-ready");
              resolve(undefined);
            });
          };

          preloaded.addEventListener("load", applyImage, { once: true });
          preloaded.addEventListener("error", applyImage, { once: true });
        });

      const showLightboxImage = async (index = 0) => {
        currentLightboxIndex =
          ((index % homeLightboxItems.length) + homeLightboxItems.length) %
          homeLightboxItems.length;

        const item = homeLightboxItems[currentLightboxIndex];
        if (!(item instanceof HTMLElement)) {
          return;
        }

        lightboxTitle.textContent = item.dataset.title ?? "";
        lightboxCat.textContent = item.dataset.cat ?? "";
        lightboxCounter.textContent = `${currentLightboxIndex + 1} / ${homeLightboxItems.length}`;

        await swapLightboxImage(
          item.dataset.src ?? "",
          item.dataset.alt ?? "Imagen ampliada",
          item.dataset.aspect,
        );
      };

      const openLightbox = async (index = 0) => {
        homeLightbox.setAttribute("aria-hidden", "false");
        syncScrollLock();
        lightboxImage.classList.remove("is-ready");
        lightboxImage.removeAttribute("src");
        await showLightboxImage(index);

        if (homeLightbox.getAttribute("aria-hidden") === "true") {
          return;
        }

        closeButton.focus();
      };

      const closeLightbox = () => {
        lightboxImageToken += 1;
        homeLightbox.setAttribute("aria-hidden", "true");
        syncScrollLock();
      };

      homeLightboxItems.forEach((item, index) => {
        if (!(item instanceof HTMLButtonElement)) {
          return;
        }

        item.addEventListener("click", () => {
          void openLightbox(index);
        });
      });

      prevArrow.addEventListener("click", () => {
        void showLightboxImage(currentLightboxIndex - 1);
      });
      nextArrow.addEventListener("click", () => {
        void showLightboxImage(currentLightboxIndex + 1);
      });
      closeButton.addEventListener("click", closeLightbox);

      homeLightbox.addEventListener("click", (event) => {
        if (event.target === homeLightbox) {
          closeLightbox();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (homeLightbox.getAttribute("aria-hidden") === "true") {
          return;
        }

        if (event.key === "Escape") {
          closeLightbox();
        }
        if (event.key === "ArrowLeft") {
          void showLightboxImage(currentLightboxIndex - 1);
        }
        if (event.key === "ArrowRight") {
          void showLightboxImage(currentLightboxIndex + 1);
        }
      });
    }
  }
</script>

<style>
  .home-section {
    padding-bottom: var(--space-section);
  }

  .home-section--photos {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--header-height) + var(--space-md));
    overflow: hidden;
  }

  .home-section--photos::before,
  .home-section--photos::after {
    content: "";
    position: absolute;
    left: 50%;
    width: 100vw;
    transform: translateX(-50%);
    pointer-events: none;
  }

  .home-section--photos::before {
    inset-block: 0;
    background: linear-gradient(
      var(--hero-gradient-angle),
      var(--color-hero-1) var(--hero-stop-1),
      var(--color-hero-2) var(--hero-stop-2),
      var(--color-hero-3) var(--hero-stop-3),
      var(--color-hero-4) var(--hero-stop-4)
    );
    animation: heroShift 20s ease-in-out infinite alternate;
    z-index: -2;
  }

  .home-section--photos::after {
    inset-block: 0;
    background:
      linear-gradient(to top, var(--color-bg) 0%, transparent 50%),
      linear-gradient(to right, rgba(10, 10, 10, 0.5) 0%, transparent 60%);
    z-index: -1;
  }

  .home-section__inner {
    position: relative;
    z-index: 1;
  }

  .home-brand-logo {
    display: flex;
    justify-content: center;
    width: fit-content;
    margin: 0 auto var(--space-xl);
  }

  .home-brand-logo img {
    width: clamp(170px, 18vw, 270px);
    height: auto;
  }

  .home-photo-carousel {
    position: relative;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .home-photo-carousel__status {
    top: 0;
    left: 0;
  }

  .home-photo-carousel__footer {
    display: flex;
    justify-content: center;
    margin-top: var(--space-md);
  }

  .home-photo-carousel__viewport {
    overflow: visible;
  }

  .home-photo-carousel__viewport::-webkit-scrollbar {
    display: none;
  }

  .home-photo-carousel__track {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: start;
    gap: 0.45rem;
  }

  .home-photo-carousel__slide {
    display: flex;
    flex-direction: column;
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
    text-decoration: none;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }

  .home-photo-carousel__slide:focus-visible .home-photo-carousel__media {
    outline: 2px solid var(--color-ocean);
    outline-offset: 3px;
  }

  .home-photo-carousel__media {
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.05);
    background: var(--color-bg-raised);
  }

  .home-photo-carousel__category-label {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    text-align: center;
    padding: var(--space-sm);
    color: var(--color-text);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(var(--text-sm), 0.95vw + 0.5rem, var(--text-lg));
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-shadow: 0 2px 14px rgba(0, 0, 0, 0.76);
    background: linear-gradient(
      180deg,
      rgba(6, 6, 6, 0.24),
      rgba(6, 6, 6, 0.52)
    );
    pointer-events: none;
  }

  .home-photo-carousel__slide--primary .home-photo-carousel__category-label {
    font-size: clamp(0.62rem, 1.6vw, var(--text-lg));
    letter-spacing: 0.1em;
  }

  .home-photo-carousel__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 5;
    transition:
      transform var(--duration-slow) var(--ease-out-expo),
      opacity var(--duration-base) var(--ease-out-expo);
  }

  .home-photo-carousel__slide:hover .home-photo-carousel__image {
    transform: scale(1.04);
  }

  .home-photo-carousel__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    width: fit-content;
    max-width: 100%;
    flex-wrap: wrap;
  }

  .home-photo-carousel__button {
    width: 2.6rem;
    height: 2.6rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    color: var(--color-text-muted);
    transition:
      color var(--duration-fast) var(--ease-out-quart),
      border-color var(--duration-fast) var(--ease-out-quart),
      background var(--duration-fast) var(--ease-out-quart);
  }

  .home-photo-carousel__button:hover:not(:disabled) {
    color: var(--color-text);
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.05);
  }

  .home-photo-carousel__button:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .home-photo-carousel__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
    max-width: min(100%, 480px);
  }

  .home-photo-carousel__dot {
    width: 0.55rem;
    height: 0.55rem;
    padding: 0;
    border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.16);
    transition:
      transform var(--duration-fast) var(--ease-out-quart),
      background var(--duration-fast) var(--ease-out-quart),
      border-color var(--duration-fast) var(--ease-out-quart);
  }

  .home-photo-carousel__dot[data-active="true"] {
    background: var(--color-accent);
    border-color: var(--color-accent);
    transform: scale(1.15);
  }

  .home-photo-carousel__dot:hover,
  .home-photo-carousel__dot:focus-visible {
    border-color: rgba(255, 255, 255, 0.52);
    background: rgba(255, 255, 255, 0.4);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(6, 6, 6, 0.94);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    opacity: 1;
    visibility: visible;
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0s,
      backdrop-filter 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lightbox[aria-hidden="true"] {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    backdrop-filter: blur(0px);
    -webkit-backdrop-filter: blur(0px);
    transition:
      opacity 0.4s cubic-bezier(0.22, 1, 0.36, 1),
      visibility 0s linear 0.4s,
      backdrop-filter 0.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .lightbox__close {
    position: absolute;
    top: var(--space-md);
    right: var(--space-md);
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5em;
    z-index: 2;
    opacity: 1;
    transition:
      color var(--duration-fast) var(--ease-out-quart),
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0.18s;
  }

  .lightbox[aria-hidden="true"] .lightbox__close {
    opacity: 0;
    transition-delay: 0s;
  }

  .lightbox__close:hover {
    color: var(--color-text);
  }

  .lightbox__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 2;
    color: var(--color-text-dim);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    opacity: 1;
    transition:
      color var(--duration-fast) var(--ease-out-quart),
      background var(--duration-fast) var(--ease-out-quart),
      border-color var(--duration-fast) var(--ease-out-quart),
      opacity 0.35s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: 0.12s;
  }

  .lightbox[aria-hidden="true"] .lightbox__arrow {
    opacity: 0;
    transition-delay: 0s;
  }

  .lightbox[aria-hidden="true"] .lightbox__arrow--prev {
    transform: translateY(-50%) translateX(-12px);
